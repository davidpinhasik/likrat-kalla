# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Without these values the site still builds and runs
# using built-in seed data (see src/lib/data/seed.ts).

# --- Supabase (Project Settings -> API Keys / Connect) ------------------------
# Server-side URL and anon / publishable key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Browser-side copies of the same values (supports both anon and new publishable key format)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role / secret key: SERVER ONLY, bypasses Row Level Security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
# or SUPABASE_SECRET_KEY=sb_secret_...

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
# Optional sender address (must be a domain verified in Resend)
EMAIL_FROM=Likrat Kalla <donations@helpjewishbrides.org>

# --- Site ---------------------------------------------------------------------
# Public origin, used to build the thank-you return URL sent to Lemaan Achai
NEXT_PUBLIC_SITE_URL=https://www.helpjewishbrides.org

# --- Lemaan Achai ---------------------------------------------------------------
LEMAAN_ACHAI_BASE_URL=https://www.lemaanachai.org
